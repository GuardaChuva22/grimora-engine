// Energy: lightning living in the body. Thin veins of current crawl over the skin and
// flicker, bolts jump off it everywhere with sparks, and a few strands of light trail off.
(
    name: "Energia",
    ramp: [(0.05, 0.2, 0.9, 1.8), (0.25, 0.6, 1.0, 4.5), (0.7, 0.92, 1.0, 9.0), (0.95, 1.0, 1.0, 16.0)],
    bands: 0.0,
    skin: [
        (pattern: Veins, scale: 4.0, speed: 0.6, warp: 0.8, outline: 0.5, edge: 3.0, glow: 6.0),
    ],
    wisps: [
        (rate: 30.0, size: 0.025, tall: 0.0, life: (0.3, 0.6), push: 0.6, rise: 0.5, curl: 2.5, curl_scale: 0.3, trail: 0.25, shape: Soft, opacity: 1.0, additive: 1.0, grain: 0.2, warp: 0.1),
    ],
    bolts: (rate: 16.0, size: 0.3, reach: 1.0, glow: 14.0, sparks: 5),
    orbs: (count: 4.0, distance: 0.45, speed: 3.2, size: 0.04, trail: 0.4, wander: 0.8),
    hands: (rate: 10.0, size: 0.07, sparks: 12.0),
    light: (color: (0.4, 0.7, 1.0), intensity: 4.0, radius: 6.0, flicker: 0.6, linger: 0.15),
    burst: (wave: 6.0, streaks: 50, flash: 14.0),
)
