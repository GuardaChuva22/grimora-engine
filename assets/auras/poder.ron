// Power: the golden aura of a warrior at the peak, anime style. The body glows gold from
// within, fire races up it, and tall flames stream off the whole body straight up; lines of
// light shoot past, lightning crawls on it and the ground breaks around.
(
    name: "Poder",
    power: 1.1,
    ramp: [(0.9, 0.5, 0.05, 2.0), (1.0, 0.78, 0.18, 5.0), (1.0, 0.94, 0.5, 9.0), (1.0, 1.0, 0.88, 14.0)],
    bands: 4.0,
    skin: [
        (pattern: Ghost, scale: 3.0, speed: 2.0, warp: 0.4, outline: 1.0, edge: 2.0, cover: 0.3, body: 1.2, glow: 1.6),
        (pattern: Fire, scale: 6.0, speed: 3.0, warp: 0.5, outline: 0.0, edge: 2.0, glow: 2.0),
        (pattern: Blaze, scale: 1.3, speed: 3.2, warp: 0.5, outline: 0.12, edge: 1.6, cover: 0.1, glow: 1.2),
    ],
    glow: (opacity: 0.06, size: 0.75, breath: 0.15, breath_rate: 2.0),
