// A ray: buried in the sand by day, gliding over the bottom at night, and it hunts crabs.
SpeciesDesc(
    name: "arraia",
    description: "Dorme enterrada durante o dia, e só se defende de quem pisa nela. À noite, sai atrás de caranguejos.",
    life: Gliding,
    model: "../models/animals/Arraia.glb",
    forward: (0.0, 0.0, 1.0),
    size: (0.9, 1.3),
    shadow: true,
    puff: "../effects/sand_puff.ron",
    diet: ["caranguejo"],
    swim: (
        cruise: 0.9,
        sprint: 4.0,
        turn: 1.3,
        beats_per_meter: 0.5,
        idle_beat: 0.25,
        // A wave running out along each wing, and the tail following behind.
        wave: [
            (joint: "Pectoral.01.L", axis: (0.0, 0.0, 1.0), sway: 7.0, delay: 0.0),
            (joint: "Pectoral.02.L", axis: (0.0, 0.0, 1.0), sway: 13.0, delay: 0.14),
            (joint: "Pectoral.03.L", axis: (0.0, 0.0, 1.0), sway: 18.0, delay: 0.3),
            (joint: "Pectoral.01.R", axis: (0.0, 0.0, 1.0), sway: -7.0, delay: 0.0),
            (joint: "Pectoral.02.R", axis: (0.0, 0.0, 1.0), sway: -13.0, delay: 0.14),
            (joint: "Pectoral.03.R", axis: (0.0, 0.0, 1.0), sway: -18.0, delay: 0.3),
            (joint: "Tail.01", sway: 3.0, delay: 0.1, bend: 12.0),
            (joint: "Tail.02", sway: 5.0, delay: 0.25, bend: 14.0),
            (joint: "Tail.03", sway: 8.0, delay: 0.42, bend: 16.0),
        ],
    ),
    glide: (
        // How high over the bottom it cruises: (lowest, highest).
        over_floor: (0.35, 1.3),
        // It needs this much water.
        shallowest: 0.75,
        // How far it can smell a crab, and how close it must get to take one.
        smell: 16.0,
        catch_radius: 0.45,
        // How far it goes from where it starts.
        roam: 16.0,
        // Seconds it stays down after eating.
        rest: (30.0, 90.0),
        // How much hunger one crab takes away.
        meal: 0.6,
    ),
    needs: (hungry_after: 1400.0, tired_after: 300.0, rested_after: 80.0),
    senses: (notice: 1.0, calm_seconds: 4.0),
    // In game days.
    cycle: (births: 0.2, lives: 30.0, room: 1.4, starves_in: 8.0, arrives_every: 4.0, newborn: 0.5, grows_in: 12.0),
    // Only when it's stepped on under the sand: it's the worst thing on the beach.
    harm: (
        damage: 18.0,
        reach: 0.45,
        every: 1.0,
        staggers: true,
        message: "O ferrão de uma arraia entrou no seu pé",
    ),
    sounds: (
        harm: "../sounds/spine_sting.wav",
        death: "../sounds/squelch.wav",
        dig: "../sounds/sand_dig.wav",
    ),
)
