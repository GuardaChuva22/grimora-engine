        (mesh: Cylinder(segments: 8), position: (-17.0, 0.0, -97.0), scale: (6.0, 24.0, 6.0),
         color: (0.85, 0.9, 1.1), texture: (path: "../textures/parede_de_pedra_umida.png", tile: 10.0)),
        (mesh: Cylinder(segments: 8), position: (-17.0, 24.0, -97.0), scale: (7.7, 2.2, 7.7), collider: None,
         color: (0.85, 0.9, 1.1), texture: (path: "../textures/tijolos_de_pedra.png", tile: 7.0)),
        (mesh: Cone(segments: 8), position: (-17.0, 26.2, -97.0), scale: (7.0, 16.0, 7.0), collider: None,
         color: (0.36, 0.33, 0.55), texture: (path: "../textures/telhado_de_telhas.png", tile: 6.0)),
        (mesh: Cylinder(segments: 8), position: (17.0, 0.0, -97.0), scale: (5.0, 18.0, 5.0),
         color: (0.85, 0.9, 1.1), texture: (path: "../textures/parede_de_pedra_umida.png", tile: 10.0)),
        (mesh: Cylinder(segments: 8), position: (17.0, 18.0, -97.0), scale: (6.4, 2.2, 6.4), collider: None,
         color: (0.85, 0.9, 1.1), texture: (path: "../textures/tijolos_de_pedra.png", tile: 7.0)),
        (mesh: Cone(segments: 8), position: (17.0, 20.2, -97.0), scale: (6.2, 13.0, 6.2), collider: None,
         color: (0.36, 0.33, 0.55), texture: (path: "../textures/telhado_de_telhas.png", tile: 6.0)),
        (mesh: Cylinder(segments: 8), position: (-8.0, 0.0, -106.0), scale: (3.2, 36.0, 3.2),
         color: (0.85, 0.9, 1.1), texture: (path: "../textures/parede_de_pedra_umida.png", tile: 10.0)),
        (mesh: Cone(segments: 8), position: (-8.0, 36.0, -106.0), scale: (4.2, 15.0, 4.2), collider: None,
         color: (0.36, 0.33, 0.55), texture: (path: "../textures/telhado_de_telhas.png", tile: 6.0)),
        (mesh: Cylinder(segments: 8), position: (-24.0, 0.0, -103.0), scale: (2.2, 20.0, 2.2),
         color: (0.85, 0.9, 1.1), texture: (path: "../textures/parede_de_pedra_umida.png", tile: 10.0)),
        (mesh: Cone(segments: 8), position: (-24.0, 20.0, -103.0), scale: (3.0, 10.0, 3.0), collider: None,
         color: (0.36, 0.33, 0.55), texture: (path: "../textures/telhado_de_telhas.png", tile: 6.0)),
        (mesh: Cylinder(segments: 8), position: (24.0, 0.0, -104.0), scale: (2.4, 15.0, 2.4),
         color: (0.85, 0.9, 1.1), texture: (path: "../textures/parede_de_pedra_umida.png", tile: 10.0)),
        (mesh: Cone(segments: 8), position: (24.0, 15.0, -104.0), scale: (3.2, 9.0, 3.2), collider: None,
         color: (0.36, 0.33, 0.55), texture: (path: "../textures/telhado_de_telhas.png", tile: 6.0)),
        (mesh: Cylinder(segments: 8), position: (10.0, 0.0, -107.0), rotation: (0.0, 0.0, -6.0), scale: (3.4, 26.0, 3.4),
         color: (0.85, 0.9, 1.1), texture: (path: "../textures/parede_de_pedra_umida.png", tile: 10.0)),
        (mesh: Cone(segments: 8), position: (12.7, 25.9, -107.0), rotation: (0.0, 0.0, -6.0), scale: (4.6, 12.0, 4.6), collider: None,
         color: (0.36, 0.33, 0.55), texture: (path: "../textures/telhado_de_telhas.png", tile: 6.0)),
        // rocks at its feet
        (mesh: Rock(seed: 14), position: (-13.0, -0.8, -94.0), scale: (15.0, 6.0, 8.0), collider: None,
         color: (0.7, 0.75, 0.9), texture: (path: "../textures/rocha_umida_escura.png", tile: 7.0)),
        (mesh: Rock(seed: 15), position: (2.0, -0.8, -92.5), scale: (12.0, 3.0, 5.0), collider: None,
         color: (0.7, 0.75, 0.9), texture: (path: "../textures/rocha_umida_escura.png", tile: 7.0)),
        (mesh: Rock(seed: 16), position: (14.0, -0.8, -93.5), scale: (14.0, 5.0, 8.0), collider: None,
         color: (0.7, 0.75, 0.9), texture: (path: "../textures/rocha_umida_escura.png", tile: 7.0)),
        (mesh: Rock(seed: 17), position: (-27.0, -0.8, -97.0), scale: (12.0, 8.0, 10.0), collider: None,
         color: (0.7, 0.75, 0.9), texture: (path: "../textures/rocha_umida_escura.png", tile: 7.0)),
        (mesh: Rock(seed: 18), position: (27.0, -0.8, -98.0), scale: (13.0, 7.0, 10.0), collider: None,
         color: (0.7, 0.75, 0.9), texture: (path: "../textures/rocha_umida_escura.png", tile: 7.0)),
        // the few windows that are still lit
        (mesh: Cube, position: (0.0, 17.0, -97.40), scale: (0.6, 2.0, 0.4), collider: None, color: (1.0, 0.6, 0.22), emissive: 4.0),
        (mesh: Cube, position: (-3.0, 22.0, -97.80), scale: (0.6, 2.0, 0.4), collider: None, color: (1.0, 0.6, 0.22), emissive: 4.0),
        (mesh: Cube, position: (3.2, 13.0, -97.90), scale: (0.6, 2.0, 0.4), collider: None, color: (1.0, 0.6, 0.22), emissive: 4.0),
        (mesh: Cube, position: (-17.0, 15.0, -93.95), scale: (0.6, 2.0, 0.4), collider: None, color: (1.0, 0.6, 0.22), emissive: 4.0),
        (mesh: Cube, position: (17.0, 11.0, -94.40), scale: (0.6, 2.0, 0.4), collider: None, color: (1.0, 0.6, 0.22), emissive: 4.0),
        (mesh: Cube, position: (-8.0, 29.0, -104.30), scale: (0.6, 2.0, 0.4), collider: None, color: (1.0, 0.6, 0.22), emissive: 4.0),

        // ---- items. `pickup` lays one down to be taken: the catalog in `items` says its mesh,
        // scale and how it lies. What is taken stays taken, through saves and streaming; give
        // it a `name` if it may move, since without one it's known by its item and place.
        (pickup: (item: "maca", count: 2), position: (-0.6, 0.0, 12.9)),
        (pickup: (item: "adaga"), position: (0.7, 0.0, 11.8), rotation: (0.0, 35.0, 0.0)),
        (pickup: (item: "pistola"), position: (-1.6, 0.0, 11.6), rotation: (0.0, 70.0, 0.0)),
        (pickup: (item: "mosquete"), position: (-2.6, 0.0, 12.5), rotation: (0.0, 130.0, 0.0)),
        (pickup: (item: "bala_de_chumbo", count: 12), position: (-1.9, 0.0, 12.2)),
        (pickup: (item: "espada_larga"), position: (2.1, 0.0, 13.6), rotation: (0.0, 110.0, 0.0)),
        (pickup: (item: "katana"), position: (-3.6, 0.0, 15.0), rotation: (0.0, 200.0, 0.0)),
        // Resting here heals, passes the hours and is where the player wakes after falling.
        (name: "campfire", mesh: Model(path: "../models/objects/Fogueira.glb"), position: (5.0, 0.0, 13.4),
         interact: (prompt: "descansar"),
         light: (position: (0.0, 0.5, 0.0), color: (1.0, 0.55, 0.25), intensity: 12.0, radius: 9.0, flicker: 1.0),
         effect: (path: "../effects/torch.ron", position: (0.0, 0.22, 0.0)),
         sound: (path: "../sounds/fire.ogg", position: (0.0, 0.3, 0.0), volume: 0.7, min_distance: 1.5, max_distance: 14.0)),
        // `container` holds items, in a grid of `size` cells; the player opens it through `interact`.
        (name: "chest", mesh: Model(path: "../models/objects/Bau.glb"), position: (-5.2, 0.0, 12.6), rotation: (0.0, 68.0, 0.0),
         interact: (prompt: "abrir o baú"),
         container: (size: (10, 5), items: [("maca", 3), ("machadinha", 1), ("cimitarra", 1), ("zweihander", 1), ("lanterna", 1),
                                            ("erva_amarga", 3), ("sucata_de_ferro", 3), ("moeda", 25),
                                            ("capacete_ferro", 1), ("peitoral_ferro", 1), ("calca_ferro", 1), ("botas_ferro", 1)])),
    ],

    // The catalog of everything there is to carry.
    items: "../items/items.ron",

    // Streaming: scattered objects are grouped into `cell_size` cells and only
    // those within `load_distance` of the camera are loaded (drawn, lit and solid).
    // Keep it beyond where the fog swallows everything (about 4 / fog.density)
    // or, as here, beyond the far edge of the map seen from its center.
    streaming: (cell_size: 32.0, load_distance: 150.0),
    // Regions: scene fragments in their own files, built in the background when
    // the camera comes within `load_distance` of their circle (center, radius).
    regions: [
        (path: "regions/shrine.ron", center: (-55.0, 0.0, -60.0), radius: 10.0),
    ],

    // Random placement; the same seed always gives the same layout.
    scatter: [
        // Dark pine forest ringing the valley. With `branches`, a pine is pictures of branches on
        // a trunk: `stem` is where each picture's branch begins. `path_margin` keeps these far
        // enough off the path for the fortress to show between them.
        (mesh: Pine(branches: [
             (path: "../textures/galho_de_pinheiro_horizontal.png", stem: (0.02, 0.46)),
             (path: "../textures/galho_de_pinheiro_pendente.png", stem: (0.95, 0.1)),
         ], bark: "../textures/tronco_coberto_musgo.png"),
         variants: 6, count: 300, radius: 104.0, min_radius: 26.0, scale: (1.3, 2.8), path_margin: 7.0,
         color: (0.82, 0.98, 0.98), color_jitter: 0.18, tilt: 3.0, seed: 11),
        // dead trees close to the circle
        (mesh: DeadTree(), variants: 5, count: 16, radius: 26.0, min_radius: 13.0, scale: (0.9, 1.5),
         color: (2.2, 2.1, 2.0), color_jitter: 0.1, tilt: 8.0, seed: 5,
         texture: (path: "../textures/madeira_apodrecida.png", tile: 1.2)),
        // boulders everywhere
        (mesh: Rock(), variants: 6, count: 70, radius: 85.0, min_radius: 6.0, scale: (0.4, 2.2),
         color: (1.8, 1.8, 1.8), color_jitter: 0.12, tilt: 20.0, sink: 0.15, seed: 3,
         texture: (path: "../textures/pedra_coberta_de_musgo.png", tile: 1.5)),
        // Plants are pictures: `Sprite` stands crossed copies of an image up, its base on the
        // ground. `size` is the height of the drawing, `sway` how far the wind moves its top
        // (default a fifth of `size`). They cast no shadow unless `shadow: true`.
        (mesh: Sprite(texture: "../textures/mato1.png", size: 0.8), count: 700, radius: 75.0, min_radius: 3.0,
         scale: (0.7, 1.3), color_jitter: 0.15, tilt: 0.0, sink: 0.03, seed: 31),
        (mesh: Sprite(texture: "../textures/mato2.png", size: 1.0), count: 500, radius: 75.0, min_radius: 5.0,
         scale: (0.7, 1.3), color_jitter: 0.15, tilt: 0.0, sink: 0.03, seed: 32),
        (mesh: Sprite(texture: "../textures/mato3.png", size: 0.8), count: 250, radius: 60.0, min_radius: 5.0,
         scale: (0.7, 1.2), color_jitter: 0.1, tilt: 0.0, sink: 0.03, seed: 33),
        (mesh: Sprite(texture: "../textures/mato4.png", size: 0.9), count: 250, radius: 70.0, min_radius: 7.0,
         scale: (0.7, 1.3), color_jitter: 0.15, tilt: 0.0, sink: 0.03, seed: 34),
        (mesh: Sprite(texture: "../textures/capim_alto.png", size: 1.3), count: 200, radius: 80.0, min_radius: 18.0,
         scale: (0.8, 1.3), color_jitter: 0.15, tilt: 0.0, sink: 0.03, seed: 35),
        (mesh: Sprite(texture: "../textures/samambaia.png", size: 1.0), count: 180, radius: 90.0, min_radius: 25.0,
         scale: (0.8, 1.5), color_jitter: 0.15, tilt: 0.0, sink: 0.03, seed: 36),
        (mesh: Sprite(texture: "../textures/arbusto_seco.png", size: 1.1, sway: 0.05), count: 40, radius: 45.0, min_radius: 10.0,
         scale: (0.8, 1.3), color_jitter: 0.1, tilt: 0.0, sink: 0.03, seed: 37),
        (mesh: Sprite(texture: "../textures/planta_espinhosa.png", size: 0.9, sway: 0.08), count: 40, radius: 50.0, min_radius: 12.0,
         scale: (0.8, 1.3), color_jitter: 0.1, tilt: 0.0, sink: 0.03, seed: 38),
        (mesh: Sprite(texture: "../textures/cogumelos_floresta.png", size: 0.5, sway: 0.0), count: 50, radius: 60.0, min_radius: 14.0,
         scale: (0.7, 1.4), color_jitter: 0.1, tilt: 0.0, sink: 0.02, seed: 39),
        // these carry an emission map, so they light up the night (but cast no light)
        (mesh: Sprite(texture: "../textures/cogumelos_luminosos.png", size: 0.55, sway: 0.0), count: 35, radius: 40.0, min_radius: 12.0,
         scale: (0.7, 1.4), color_jitter: 0.05, tilt: 0.0, sink: 0.02, seed: 40),
        // a reedbed around the pond (nothing scattered lands in the water)
        (mesh: Sprite(texture: "../textures/taboas.png", size: 1.6), center: (20.0, 0.0, 13.0), count: 45, radius: 11.5, min_radius: 7.5,
         scale: (0.8, 1.2), color_jitter: 0.1, tilt: 0.0, sink: 0.05, seed: 41),
        (mesh: Sprite(texture: "../textures/juncos.png", size: 1.3), center: (20.0, 0.0, 13.0), count: 45, radius: 12.0, min_radius: 7.5,
         scale: (0.8, 1.2), color_jitter: 0.1, tilt: 0.0, sink: 0.05, seed: 42),
        // fallen leaves: decals can be scattered too (keep `sink` at 0)
        (mesh: Decal(texture: "../textures/folhas_e_petalas_caidas.png", size: 0.9), count: 90, radius: 40.0, min_radius: 4.0,
         scale: (0.8, 1.3), color_jitter: 0.1, tilt: 0.0, sink: 0.0, seed: 43),
        // small glowing crystals hidden among the dead trees
        (mesh: Crystal(), variants: 3, count: 7, radius: 30.0, min_radius: 14.0, scale: (0.3, 0.55),
         color: (0.4, 0.78, 1.0), emissive: 2.5, tilt: 15.0, seed: 22,
         light: (position: (0.0, 0.6, 0.0), color: (0.4, 0.75, 1.0), intensity: 3.0, radius: 6.0, flicker: 0.1)),
    ],

    // Invisible areas that tell the game when the player goes in or out, by `name`.
    // Shapes: Ball(radius), Box(half_extents) and Cylinder(radius, height), which stands
    // on `position`. `y` is measured from the ground (`snap_to_ground: false` to turn that
    // off) and `rotation` turns boxes. `once: true` fires only the first time, for good.
    triggers: [
        (name: "circle", shape: Cylinder(radius: 9.5, height: 6.0)),
    ],

    // Particle effects on their own, not attached to anything (`y` from the ground).
    effects: [
        (path: "../effects/dust.ron", position: (0.0, 1.8, 2.0)),
        (path: "../effects/motes.ron", position: (0.0, 1.4, 0.0)),
        (path: "../effects/lake_motes.ron", position: (20.0, 1.7, 13.0)),
    ],

    // Looping sounds (WAV or OGG, paths relative to this file; made by tools/gen_sounds.py).
    // Without `position` a sound is ambience, the same everywhere. With it, the sound
    // pans with the camera and fades with distance: full volume up to `min_distance`,
    // silent past `max_distance` (meters; y is measured from the ground). `volume` is a
    // linear gain. Objects can carry one too, like the torches above (`sound: (...)`,
    // position is then an offset from the object).
    // What the weather sounds like (see `--weather`): `rain` and `snow` loop while they fall.
    weather_sounds: (
        rain: "../sounds/rain.wav",
        snow: "../sounds/wind.ogg",
        thunder: ["../sounds/thunder_1.wav", "../sounds/thunder_2.wav"],
    ),

    sounds: [
        (path: "../sounds/wind.ogg", volume: 0.35),
        // the heart crystal hums softly
        (path: "../sounds/hum.wav", position: (0.0, 1.6, 0.0), volume: 0.4, min_distance: 2.0, max_distance: 14.0),
    ],
)
