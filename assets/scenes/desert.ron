// A scene to judge the open day on: dunes and the ruins of something too large.
// Run with `cargo run --release -p sandbox -- --scene assets/scenes/desert.ron`.
SceneDesc(
    environment: (
        fog: (height_falloff: 0.04, base_height: 0.0, sun_scatter: 0.3,
              // Blown sand hanging over the low ground.
              mist: (amount: 0.05, top: 6.0, size: 22.0, speed: 1.4, brightness: 1.3)),
        sky: (
            sun_size: 1.6,
            sun_texture: "../textures/sol.png",
            moon_texture: "../textures/moons/maris.png",
            sun_sprite_size: 2.4,
            moon_sprite_size: 11.0,
            halo: 1.0,
            clouds: (scale: 1.0, speed: 0.6),
        ),
        wind: (direction: (1.0, 0.2), strength: 1.2, speed: 1.6),
        shadows: (enabled: true, distance: 160.0, strength: 0.75, cascades: 4),
        post: (
            contrast: 1.12, saturation: 1.1, vignette: 0.35, grain: 0.02, bloom: 0.25,
            vivid: 0.5, sharpen: 0.6, shadow_tint: (0.02, 0.0, 0.05),
        ),
        surface: (
            contrast: 1.3, saturation: 0.85, mottle: 0.6, mottle_size: 12.0,
            mottle_dark: (0.55, 0.5, 0.65), mottle_light: (1.1, 1.08, 1.0), crisp: 1.5,
        ),
    ),

    day_cycle: (time: 16.0, day_length: 480.0, sunrise: 40.0, tilt: 48.0, moon_tilt: 76.0, haze: 0.6, weather: Clear),

    player: (position: (0.0, 0.0, 26.0), yaw: 0.0),
    camera: (position: (0.0, 6.0, 34.0), look_at: (0.0, 3.0, 0.0), fov: 60.0),

    terrain: (
        size: 340.0,
        resolution: 120,
        height: 15.0,
        frequency: 1.4,
        seed: 21,
        edge_rise: 22.0,
        flat_radius: 16.0,
        textures: (
            grass: "../textures/areia.png",
            dirt: "../textures/areia_com_pedregulhos.png",
            rock: "../textures/rocha_avermelhada.png",
            tile: 6.0,
        ),
        grounds: (grass: Sand, dirt: Sand, rock: Stone),
        paths: [
            (points: [(0.0, 22.0), (3.0, 4.0), (-2.0, -22.0), (0.0, -56.0)],
             width: 4.0, texture: "../textures/pedra_arenito.png", tile: 4.0, ground: Stone),
        ],
    ),

    objects: [
        // ---- a pyramid far off, in the haze, and the gate before it
        (mesh: Cone(segments: 4), position: (0.0, -2.0, -142.0), rotation: (0.0, 45.0, 0.0), scale: (130.0, 78.0, 130.0), collider: None,
         color: (1.1, 1.0, 0.95), texture: (path: "../textures/pedra_arenito.png", tile: 16.0)),
        (mesh: Cube, position: (-12.0, -1.0, -60.0), scale: (7.0, 30.0, 7.0),
         color: (1.25, 1.15, 1.05), texture: (path: "../textures/pedra_esculpida_ornamentos.png", tile: 6.0)),
        (mesh: Cube, position: (12.0, -1.0, -60.0), rotation: (0.0, 0.0, -2.0), scale: (7.0, 23.0, 7.0),
         color: (1.25, 1.15, 1.05), texture: (path: "../textures/pedra_esculpida_ornamentos.png", tile: 6.0)),
        (mesh: Cube, position: (-5.0, 27.0, -60.0), rotation: (0.0, 0.0, -4.0), scale: (22.0, 5.0, 8.0), collider: None,
         color: (1.25, 1.15, 1.05), texture: (path: "../textures/pedra_arenito.png", tile: 6.0)),
        // ---- tall columns on either side of the way, half of them snapped
        (mesh: Pillar(seed: 1), position: (9.0, -0.3, 8.0), rotation: (0.0, 20.0, 0.0), scale: (2.4, 3.2, 2.4),
         color: (1.4, 1.3, 1.2), texture: (path: "../textures/pedra_arenito.png", tile: 2.4)),
        (mesh: Pillar(seed: 2, broken: true), position: (-9.0, -0.3, 6.0), rotation: (3.0, 80.0, 0.0), scale: (2.4, 3.2, 2.4),
         color: (1.4, 1.3, 1.2), texture: (path: "../textures/pedra_arenito.png", tile: 2.4)),
        (mesh: Pillar(seed: 4), position: (10.0, -0.3, -14.0), rotation: (0.0, 150.0, 4.0), scale: (2.4, 3.2, 2.4),
         color: (1.4, 1.3, 1.2), texture: (path: "../textures/pedra_arenito.png", tile: 2.4)),
        (mesh: Pillar(seed: 5, broken: true), position: (-10.0, -0.3, -18.0), rotation: (0.0, 240.0, 0.0), scale: (2.4, 3.2, 2.4),
         color: (1.4, 1.3, 1.2), texture: (path: "../textures/pedra_arenito.png", tile: 2.4)),
        (mesh: Pillar(seed: 7), position: (11.0, -0.3, -38.0), rotation: (0.0, 300.0, -3.0), scale: (2.4, 3.2, 2.4),
         color: (1.4, 1.3, 1.2), texture: (path: "../textures/pedra_arenito.png", tile: 2.4)),
        // a fallen one
        (mesh: Cylinder(segments: 8), position: (-11.0, 1.0, -38.0), rotation: (0.0, 30.0, 90.0), scale: (2.2, 12.0, 2.2),
         color: (1.4, 1.3, 1.2), texture: (path: "../textures/pedra_arenito.png", tile: 2.4)),
    ],

    scatter: [
        (mesh: Rock(), variants: 6, count: 70, radius: 150.0, min_radius: 14.0, scale: (0.8, 5.0), path_margin: 2.0,
         color: (1.3, 1.1, 1.0), color_jitter: 0.12, tilt: 20.0, sink: 0.3, seed: 3,
         texture: (path: "../textures/rocha_avermelhada.png", tile: 3.0)),
        (mesh: DeadTree(), variants: 4, count: 26, radius: 120.0, min_radius: 12.0, scale: (1.0, 2.2), path_margin: 2.0,
         color: (1.6, 1.4, 1.2), color_jitter: 0.1, tilt: 10.0, seed: 5,
         texture: (path: "../textures/madeira_queimada.png", tile: 1.2)),
        (mesh: Sprite(texture: "../textures/arbusto_seco.png", size: 1.1, sway: 0.08), count: 220, radius: 120.0, min_radius: 5.0,
         scale: (0.7, 1.5), color_jitter: 0.1, tilt: 0.0, sink: 0.03, seed: 37),
        (mesh: Sprite(texture: "../textures/planta_espinhosa.png", size: 0.9, sway: 0.08), count: 80, radius: 90.0, min_radius: 8.0,
         scale: (0.8, 1.3), color_jitter: 0.1, tilt: 0.0, sink: 0.03, seed: 38),
    ],

    // What the weather sounds like (see `--weather`): `rain` and `snow` loop while they fall.
    weather_sounds: (
        rain: "../sounds/rain.wav",
        snow: "../sounds/wind.ogg",
        // Strong winds only, louder in the gusts: still air is silent.
        wind: "../sounds/wind.ogg",
        thunder: ["../sounds/weather/thunder_1.mp3", "../sounds/weather/thunder_2.mp3", "../sounds/weather/thunder_3.mp3", "../sounds/weather/thunder_4.mp3"],
        // The bolt that comes down with each strike.
        lightning: "../effects/lightning.ron",
    ),

    sounds: [
    ],
)
