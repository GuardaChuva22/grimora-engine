// A scene to judge the open day on: an island of ruins in the sea, with a wreck offshore.
// Run with `cargo run --release -p sandbox -- --scene assets/scenes/sea.ron`.
SceneDesc(
    environment: (
        fog: (height_falloff: 0.09, base_height: 0.0, sun_scatter: 0.25),
        sky: (
            sun_size: 1.6,
            sun_texture: "../textures/sol.png",
            moon_texture: "../textures/moons/maris.png",
            sun_sprite_size: 2.4,
            moon_sprite_size: 11.0,
            halo: 1.0,
            clouds: (scale: 1.2, speed: 1.0),
        ),
        wind: (direction: (1.0, 0.35), strength: 1.2, speed: 1.6),
        shadows: (enabled: true, distance: 140.0, strength: 0.7, cascades: 4),
        post: (
            contrast: 1.15, saturation: 1.15, vignette: 0.35, grain: 0.02, bloom: 0.25,
            vivid: 0.6, sharpen: 0.6, shadow_tint: (0.0, 0.01, 0.04),
        ),
        surface: (
            contrast: 1.35, saturation: 0.95, mottle: 0.6, mottle_size: 7.0,
            mottle_dark: (0.5, 0.5, 0.65), mottle_light: (1.1, 1.1, 1.0), crisp: 1.5,
        ),
    ),

    day_cycle: (time: 15.5, day_length: 480.0, sunrise: 40.0, tilt: 52.0, moon_tilt: 76.0, haze: 0.4, weather: Clear),

    player: (position: (0.0, 0.0, 20.0), yaw: 0.0),
    camera: (position: (0.0, 6.0, 28.0), look_at: (0.0, 3.0, 0.0), fov: 60.0),

    // A negative `edge_rise` makes the land fall away at the borders, into the sea.
    terrain: (
        size: 220.0,
        resolution: 90,
        height: 5.0,
        frequency: 2.0,
        seed: 12,
        edge_rise: -26.0,
        flat_radius: 22.0,
        textures: (
            grass: "../textures/areia_de_praia.png",
            dirt: "../textures/areia_com_pedregulhos.png",
            rock: "../textures/rocha_umida_escura.png",
            tile: 5.0,
        ),
        grounds: (grass: Sand, dirt: Sand, rock: Stone),
        paths: [
            (points: [(0.0, 18.0), (-3.0, 4.0), (2.0, -12.0), (0.0, -34.0)],
             width: 3.0, texture: "../textures/piso_de_pedra_gasto.png", tile: 3.2, ground: Stone),
        ],
    ),

    // What water sounds like, near it and under it, and what happens when something falls in.
    water_sounds: (
        sea: "../sounds/sea.wav",
        river: "../sounds/river.wav",
        underwater: "../sounds/underwater.wav",
        splash: ["../sounds/splash_1.wav", "../sounds/splash_2.wav"],
        splash_effect: "../effects/splash.ron",
    ),

    // A sea: endless, around the camera. `sea` says what its waves are like, and the weather
    // makes them higher. `look` is its colors: try a low `clarity` and a high `murk` for a
    // muddy sea, or a high `clarity` and a pale `shallow` for a crystal one.
    water: [
        (position: (0.0, -3.2, 0.0), texture: "../textures/agua.png", tile: 5.0,
         sea: (swell: 0.75, length: 55.0, chop: 0.16, steepness: 0.7, spread: 45.0),
         look: (deep: (0.06, 0.42, 0.72), shallow: (0.3, 1.0, 0.9), clarity: 16.0, murk: 0.2,
                refraction: 0.7, foam: 1.0, foam_color: (0.92, 0.97, 0.96), caustics: 1.0)),
    ],

    // Animals: `species` says what they are like, and they stay within `radius` of `position`.
    // Sardines around the boats, and the gulls that live on them.
    fauna: [
        (species: "../fauna/gaivota.ron", position: (0.0, 0.0, 40.0), radius: 110.0, count: 14, seed: 3),
        // Along the south beach: crabs in their holes and rays in the sand off it. Jellyfish further out.
        (species: "../fauna/caranguejo.ron", position: (10.0, 0.0, 72.0), radius: 34.0, count: 26, seed: 4),
        (species: "../fauna/arraia.ron", position: (10.0, 0.0, 78.0), radius: 20.0, count: 5, seed: 5),
        (species: "../fauna/agua_viva.ron", position: (-5.0, 0.0, 112.0), radius: 30.0, count: 28, seed: 6),
        (species: "../fauna/sardinha.ron", position: (30.0, 0.0, 92.0), radius: 22.0, count: 260, seed: 1),
        (species: "../fauna/sardinha.ron", position: (-40.0, 0.0, 88.0), radius: 30.0, count: 180, seed: 2),
    ],

    objects: [
        // ---- a ruined tower at the end of the path
        (mesh: Cylinder(segments: 10), position: (0.0, -0.5, -40.0), scale: (9.0, 26.0, 9.0),
         color: (1.2, 1.15, 1.1), texture: (path: "../textures/pedra_arenito.png", tile: 6.0)),
        (mesh: Cylinder(segments: 10), position: (0.0, 25.5, -40.0), scale: (12.0, 2.2, 12.0), collider: None,
         color: (1.2, 1.15, 1.1), texture: (path: "../textures/tijolos_de_pedra.png", tile: 5.0)),
        (mesh: Cone(segments: 10), position: (0.0, 27.7, -40.0), scale: (11.0, 14.0, 11.0), collider: None,
         color: (0.75, 0.6, 0.6), texture: (path: "../textures/telhado_de_telhas.png", tile: 4.0)),
        // broken columns along the way
        (mesh: Pillar(seed: 1), position: (6.0, 0.0, 6.0), rotation: (0.0, 40.0, 0.0), scale: (1.4, 1.4, 1.4),
         color: (1.4, 1.3, 1.2), texture: (path: "../textures/pedra_arenito.png", tile: 1.6)),
        (mesh: Pillar(seed: 2, broken: true), position: (-7.0, 0.0, 2.0), rotation: (0.0, 110.0, 0.0), scale: (1.4, 1.4, 1.4),
         color: (1.4, 1.3, 1.2), texture: (path: "../textures/pedra_arenito.png", tile: 1.6)),
        (mesh: Pillar(seed: 3, broken: true), position: (8.0, 0.0, -10.0), rotation: (5.0, 200.0, 0.0), scale: (1.4, 1.4, 1.4),
         color: (1.4, 1.3, 1.2), texture: (path: "../textures/pedra_arenito.png", tile: 1.6)),
        (mesh: Pillar(seed: 5), position: (-8.0, 0.0, -14.0), rotation: (0.0, 300.0, 0.0), scale: (1.4, 1.4, 1.4),
         color: (1.4, 1.3, 1.2), texture: (path: "../textures/pedra_arenito.png", tile: 1.6)),

        // ---- a wreck offshore: the hull on its side, masts and what is left of a sail
        (mesh: Cone(segments: 7), position: (70.0, 21.0, -130.0), rotation: (86.0, 18.0, 12.0), scale: (8.0, 34.0, 6.5), collider: None,
         color: (0.6, 0.5, 0.45), texture: (path: "../textures/tabuas_de_madeira.png", tile: 3.0)),
        (mesh: Cylinder(segments: 6), position: (72.0, 6.0, -112.0), rotation: (4.0, 0.0, -6.0), scale: (1.4, 34.0, 1.4), collider: None,
         color: (0.7, 0.6, 0.55), texture: (path: "../textures/madeira_apodrecida.png", tile: 3.0)),
        (mesh: Cylinder(segments: 6), position: (84.0, 12.0, -128.0), rotation: (-6.0, 0.0, 10.0), scale: (1.2, 26.0, 1.2), collider: None,
         color: (0.7, 0.6, 0.55), texture: (path: "../textures/madeira_apodrecida.png", tile: 3.0)),
        (mesh: Cylinder(segments: 6), position: (84.0, 34.0, -112.0), rotation: (0.0, 15.0, 90.0), scale: (0.7, 18.0, 0.7), collider: None,
         color: (0.7, 0.6, 0.55), texture: (path: "../textures/madeira_apodrecida.png", tile: 3.0)),
        (mesh: Sprite(texture: "../textures/bandeira_rasgada.png", size: 13.0, planes: 1, sway: 0.5), position: (75.0, 21.0, -113.0), rotation: (0.0, 15.0, 0.0)),

        // ---- what floats. `deck` is how high the hull keeps the water out, in the model's units,
        // and `hollow` means the water isn't drawn inside it: for boats, not for crates.
        (name: "chalupa", ground: Some(Wood), mesh: Model(path: "../models/boats/Chalupa.glb"), position: (46.0, -2.5, 118.0), snap_to_ground: false,
         rotation: (0.0, 25.0, 0.0), body: Dynamic(friction: 0.7),
         float: (deck: 1.85, mass: 26000.0, ballast: 0.65, drag: (0.25, 1.1, 1.1), hollow: true)),
        (name: "bote", ground: Some(Wood), mesh: Model(path: "../models/boats/Bote.glb"), position: (18.0, -2.5, 100.0), snap_to_ground: false,
         rotation: (0.0, -40.0, 0.0), body: Dynamic(friction: 0.7),
         float: (mass: 170.0, ballast: 0.5, drag: (0.3, 1.2, 1.2), hollow: true)),
        (name: "caixa", mesh: Cube, position: (6.0, 2.0, 92.0), snap_to_ground: false, scale: (0.9, 0.9, 0.9),
         rotation: (10.0, 20.0, 15.0), body: Dynamic(), float: (fill: 0.4),
         texture: (path: "../textures/caixa_de_madeira.png", tile: 0.9)),
        (name: "caixa pesada", mesh: Cube, position: (12.0, 3.0, 88.0), snap_to_ground: false, scale: (1.1, 1.1, 1.1),
         rotation: (30.0, 5.0, -10.0), body: Dynamic(), float: (fill: 0.8),
         texture: (path: "../textures/caixa_de_madeira.png", tile: 1.1)),
        (name: "barril", mesh: Cylinder(segments: 10), position: (0.0, 2.0, 96.0), snap_to_ground: false, scale: (0.6, 1.0, 0.6),
         rotation: (80.0, 0.0, 0.0), body: Dynamic(), float: (fill: 0.3),
         texture: (path: "../textures/madeira_lisa.png", tile: 0.8)),
        (name: "barril 2", mesh: Cylinder(segments: 10), position: (-5.0, 2.5, 90.0), snap_to_ground: false, scale: (0.6, 1.0, 0.6),
         rotation: (0.0, 0.0, 20.0), body: Dynamic(), float: (fill: 0.55),
         texture: (path: "../textures/madeira_lisa.png", tile: 0.8)),

        // ---- rocks standing in the sea
        (mesh: Rock(seed: 5), position: (-96.0, -4.0, -70.0), scale: (34.0, 46.0, 30.0), collider: None,
         color: (1.0, 1.0, 1.1), texture: (path: "../textures/rocha_umida_escura.png", tile: 8.0)),
        (mesh: Rock(seed: 6), position: (-128.0, 12.0, -36.0), scale: (22.0, 26.0, 20.0), collider: None,
         color: (1.0, 1.0, 1.1), texture: (path: "../textures/rocha_umida_escura.png", tile: 8.0)),
        (mesh: Rock(seed: 7), position: (110.0, 12.0, 42.0), scale: (26.0, 30.0, 22.0), collider: None,
         color: (1.0, 1.0, 1.1), texture: (path: "../textures/rocha_umida_escura.png", tile: 8.0)),
    ],

    scatter: [
        (mesh: Rock(), variants: 5, count: 30, radius: 95.0, min_radius: 12.0, scale: (0.5, 2.6),
         color: (1.3, 1.25, 1.2), color_jitter: 0.12, tilt: 20.0, sink: 0.15, path_margin: 1.0, seed: 3,
         texture: (path: "../textures/pedra_arenito.png", tile: 1.5)),
        (mesh: DeadTree(), variants: 4, count: 16, radius: 62.0, min_radius: 14.0, scale: (1.2, 2.4), path_margin: 2.0,
         color: (1.8, 1.6, 1.4), color_jitter: 0.1, tilt: 8.0, seed: 5,
         texture: (path: "../textures/madeira_apodrecida.png", tile: 1.2)),
        (mesh: Sprite(texture: "../textures/capim_alto.png", size: 1.3), count: 340, radius: 62.0, min_radius: 3.0,
         scale: (0.8, 1.4), color_jitter: 0.15, tilt: 0.0, sink: 0.03, seed: 35),
        (mesh: Sprite(texture: "../textures/arbusto_seco.png", size: 1.1, sway: 0.05), count: 60, radius: 70.0, min_radius: 4.0,
         scale: (0.8, 1.3), color_jitter: 0.1, tilt: 0.0, sink: 0.03, seed: 37),
    ],

    // What the weather sounds like (see `--weather`): `rain` and `snow` loop while they fall.
    weather_sounds: (
        rain: "../sounds/rain.wav",
        snow: "../sounds/wind.ogg",
        thunder: ["../sounds/thunder_1.wav", "../sounds/thunder_2.wav"],
    ),

    sounds: [
        (path: "../sounds/wind.ogg", volume: 0.35),
    ],
)
