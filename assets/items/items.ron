// Everything there is to carry. A scene names this file in its `items`, and its objects name
// these ids in `pickup` and `container`.
//
// `model` is relative to this file. `scale` goes from the model's units to meters: the weapons
// are drawn at 0.263 meters to the unit, which gives the hand the 2.37 cm thick handle that
// `chartest_grip.ron` wraps the fingers around. `icon` is `icons/<id>.png` if not given
// (`cargo run --release -p icon_maker` draws them from the models).
//
// Weapons: `blade` is in meters from the grip, `grip` is where along the model the hand closes
// (in its units, for models whose origin isn't there), and `turn` is 90 for those with one
// edge, whose +X is where they cut. They all have the same blows for now, the light sword's,
// written for one hand; those that want two look wrong until they have their own.
[
    // ---- grimoires: `at` and `turn` place the open book on the left hand's palm, and each of
    // `spells` has its picture in `icons/<id>.png`. What they do is up to the game.
    (id: "grimorio_de_gelo", size: (2, 2), name: "Grimório de Gelo",
     description: "As contas de uma casa que congelou inteira. Algumas páginas ainda estão frias.",
     model: "../models/objects/Livro-Articulado.glb", scale: 1.25,
     kind: Grimoire(at: (-0.069, 0.133, -0.091), turn: (74.8, -121.3, 98.2), spells: [
         (id: "lanca_de_gelo", name: "Lança de Gelo", description: "Forma uma lança na mão, para mirar e arremessar. Racha no impacto."),
         (id: "pisao_de_gelo", name: "Pisão de Gelo", description: "Um pisão que manda o gelo pelo chão, em cone, à frente."),
         (id: "explosao_de_gelo", name: "Explosão de Gelo", description: "Uma explosão em volta de você. Quem ela alcança fica preso no gelo."),
     ])),

    // ---- straight swords
    (id: "espada_reta", size: (1, 3), name: "Espada reta", description: "Uma lâmina honesta, de dois fios.",
     model: "../models/weapons/espada_reta.glb", scale: 0.263,
     kind: Weapon(weapon: (damage: 10.0, reach: 1.9, cooldown: 0.0, clip: "sword_1", combo: ["sword_2", "sword_3"],
                           blade: (base: 0.11, tip: 0.79, radius: 0.05), stamina: 16.0, hit_stop: 0.075))),
    (id: "espada_larga", size: (1, 4), name: "Espada larga", description: "Mais ferro, mais alcance, mais fôlego gasto.",
     model: "../models/weapons/espada_larga.glb", scale: 0.263,
     kind: Weapon(weapon: (damage: 14.0, reach: 2.2, cooldown: 0.0, clip: "heavy_1", combo: ["heavy_2", "heavy_3"],
                           blade: (base: 0.066, tip: 1.03, radius: 0.06), stamina: 22.0, hit_stop: 0.12), grip: 0.12)),
    (id: "rapieira", size: (1, 4), name: "Rapieira", description: "Fina e comprida, com uma guarda que trabalhou mais que a lâmina.",
     model: "../models/weapons/rapieira.glb", scale: 0.263,
     kind: Weapon(weapon: (damage: 9.0, reach: 2.0, cooldown: 0.0, clip: "sword_1", combo: ["sword_2", "sword_3"],
                           blade: (base: 0.11, tip: 0.91, radius: 0.03), stamina: 12.0, hit_stop: 0.05))),
    (id: "florete", size: (1, 4), name: "Florete", description: "Quase uma agulha. Quase não pesa.",
     model: "../models/weapons/florete.glb", scale: 0.263,
     kind: Weapon(weapon: (damage: 8.0, reach: 2.0, cooldown: 0.0, clip: "sword_1", combo: ["sword_2", "sword_3"],
                           blade: (base: 0.17, tip: 0.92, radius: 0.03), stamina: 11.0, hit_stop: 0.05))),

