// The leap ("Arremetida", Z or L3): hold to crouch, release to leap up, press again in the
// air to stop at the top and dash where the camera looks. Read again at every leap, so it
// can be tuned while playing. Speeds in m/s, angles in radians, camera distances in meters.
// Seconds are real ones where the world is slowed (charge, apex, freeze), world ones elsewhere.
(
    // Charge: a tap counts as `charge_least`, holding past `charge_most` leaps by itself.
    charge_least: 0.12,
    charge_most: 0.55,
    charge_slow: 0.8,       // world speed while crouching
    charge_fov: -0.08,      // negative narrows the view: tension
    charge_pull: -0.8,      // the camera comes closer
    charge_rumble: 0.012,

    // Rise
    rise_least: 11.0,       // upward speed for a tap...
    rise_most: 17.0,        // ...and for a full charge
    rise_ahead: 2.5,        // towards the movement keys
    rise_keep: 0.5,         // share of the run speed it keeps
    hang_from: 4.0,         // under this upward speed it hangs at the top
    hang_gravity: 0.3,
    hang_most: 0.7,         // how long it hangs before falling, without a dash
    rise_fov: 0.12,
    rise_pull: 1.5,
    rise_lag: 0.12,         // the camera trails behind as it goes up
    launch_shake: 0.18,
    launch_kick: 0.12,      // the view is thrown up

    // Apex: press the leap again in the air
    dash_after: 0.15,       // seconds after the launch before the dash can be asked for
    apex_seconds: 0.2,
    apex_slow: 0.2,
    apex_fov: -0.12,
    apex_pull: 0.4,

    // Burst and dash
    freeze_seconds: 0.06,   // the instant of near stillness as it breaks through
    freeze_slow: 0.03,
    burst_shake: 0.35,
    dash_speed: 42.0,
    dash_lift: 0.1,         // added to where the camera looks
    dash_pitch_least: -1.1,
    dash_pitch_most: 0.9,
    dash_cruise: 13.0,      // drag never takes it under this speed
    dash_drag: 1.1,         // per second, of the speed above cruise
    dash_gravity: 0.55,     // share of gravity once it is back...
    gravity_in: 0.9,        // ...after these seconds
    dash_steer: 1.4,        // radians per second it can turn
    dash_lean: 0.6,         // 1.57 lies flat
    glide_pitch: 1.3,       // flying pose: nose down diving, up climbing, at most this
    dash_cost: 25.0,        // stamina
    dash_fov: 0.5,          // at full speed, easing to nothing at cruise
    dash_pull: 2.5,
    dash_lag: 0.15,
    dash_rumble: 0.05,
    flare_height: 2.5,      // under this height it rises from lying flat to its feet

    // Flight: press Z again while dashing. WASD along the camera (W follows where it looks),
    // Space up, Ctrl down, Shift fast; let go of everything and it levitates. Z again lets go.
    fly_after: 0.2,         // real seconds into the dash before it can take off
    fly_speed: 18.0,
    fly_fast: 40.0,         // with Shift
    fly_climb: 10.0,         // Space and Ctrl
    fly_lift: 0.2,          // radians added to the camera's pitch, so a level look flies level
    fly_accel: 3.0,         // per second: lower is more inertia
    fly_stop: 3.5,          // per second, with no keys: how long it drifts before hovering
    hover_from: 6.0,        // under this speed it levitates...
    fly_from: 9.0,          // ...over this it flies; between the two it keeps what it was doing
    fly_fade: 0.3,          // seconds the two poses take to blend
    fly_pitch: 1.0,         // flying pose: nose up and down with the way it goes
    hover_lean: 0.3,        // levitating: leans into the way it drifts
    fly_bank: 0.55,         // roll into turns
    fly_fov: 0.3,           // camera at full speed
    fly_pull: 1.5,
    fly_lag: 0.1,
    fly_rumble: 0.02,

    // Walls and landing
    bonk_from: 12.0,        // speed lost against a wall that bounces it back
    bonk_back: 4.0,
    land_seconds: 0.6,      // skid, and the landing clip
    land_drag: 3.5,
    roll_from: 7.0,         // rolls if it comes in faster than this along the ground
    land_shake: 0.25,
)
