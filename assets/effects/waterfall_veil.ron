// Off the face of a falling sheet, played at a few points down it: drops torn off it. No mist
// here: against the rock, lit from the side, it read as brown smears over the water. Written
// for a fall about 5 meters wide, scaled like `waterfall.ron`.
[
    // drops torn off the sheet, falling with it
    (
        rate: 12.0,
        lifetime: (0.6, 1.2),
        area: (2.4, 2.5, 0.5),
        direction: (0.0, -1.0, 0.0),
        spread: 30.0,
        speed: (1.5, 4.0),
        acceleration: (0.0, -9.8, 0.0),
        sizes: [0.09, 0.07, 0.03],
        size_jitter: 0.5,
        colors: [(0.97, 1.0, 1.0, 0.85), (0.93, 0.98, 1.0, 0.6), (0.9, 0.97, 1.0, 0.0)],
        lit: 0.5,
        emissive: 0.35,
        stretch: 0.05,
        max_distance: 200.0,
    ),
]
