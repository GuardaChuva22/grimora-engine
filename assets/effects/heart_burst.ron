        erode: [0.0, 0.08, 0.2, 0.42, 0.75, 1.25],
        noise: 7.0,
        grain: 0.25,
        bands: 4.0,
        pixels: 60.0,
        emissive: 1.0,
        additive: 0.9,
    ),
    // its light in the air: no steps and no bite, so its end is one slow fade
    (
        rate: 0.0,
        burst: 1,
        position: (0.0, -0.31, 0.0),
        lifetime: (1.5, 1.5),
        flat: true,
        shape: Ring,
        sizes: [1.2, 5.0, 6.8, 7.8, 8.4, 8.7],
        colors: [(1.0, 1.0, 1.0, 0.7), (1.0, 1.0, 1.0, 0.36), (1.0, 1.0, 1.0, 0.15), (1.0, 1.0, 1.0, 0.0)],
