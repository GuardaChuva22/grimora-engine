        trail_points: 26,
        sizes: [0.0, 0.05, 0.05, 0.0],
        size_jitter: 0.3,
        shape: Star,
        ramp: [(0.3, 0.06, 0.9, 2.0), (0.68, 0.34, 1.0, 4.0), (1.0, 0.92, 1.0, 8.0)],
        noise: 1.6,
        flow: (0.0, -2.0),
        grain: 0.45,
        bands: 3.0,
        pixels: 150.0,
        emissive: 1.0,
        additive: 1.0,
    ),
    // shards circling close to it
    (
        rate: 4.0,
        lifetime: (2.0, 3.6),
        position: (0.0, 0.1, 0.0),
        area: (0.55, 0.45, 0.55),
