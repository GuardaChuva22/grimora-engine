// The altar's crystal, alive: it beats and draws threads of energy up around itself. The
// sandbox switches all of it off while the crystal sleeps (`ParticleSystem::emitting`). This
// floats along with the crystal; what must stay in one place is in `heart_altar.ron`.
[
    // the air around it, always a little lit
    (
        rate: 5.0,
        lifetime: (1.0, 1.6),
        sizes: [2.0, 2.6, 2.2],
        colors: [(0.7, 0.42, 1.0, 0.0), (0.62, 0.34, 1.0, 0.05), (0.5, 0.26, 1.0, 0.0)],
        emissive: 1.0,
        additive: 1.0,
        soft: 0.5,
    ),
    // the beat: a swell of light from within
    (
        rate: 0.0,
        burst: 1,
        repeat: 2.4,
        lifetime: (0.55, 0.55),
        sizes: [0.7, 1.9],
        colors: [(0.85, 0.66, 1.0, 0.3), (0.55, 0.3, 1.0, 0.0)],
        emissive: 2.2,
        additive: 1.0,
        soft: 0.4,
    ),
    // threads of energy that spiral up into the crystal
    (
        rate: 6.0,
        lifetime: (1.6, 2.8),
        position: (0.0, 0.1, 0.0),
        area: (1.0, 0.55, 1.0),
        spread: 15.0,
