    // glints on its faces
    (
        rate: 2.2,
        lifetime: (0.22, 0.45),
        position: (0.0, 0.05, 0.0),
        area: (0.3, 0.55, 0.3),
        sizes: [0.0, 0.42, 0.0],
        size_jitter: 0.4,
        colors: [(0.95, 0.86, 1.0, 1.0)],
        emissive: 6.0,
