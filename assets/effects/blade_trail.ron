// Glints shed by the edge while the blade cuts; the sheet itself is the engine's
// `BladeTrail`. `sandbox` turns `emitting` on while the blade hurts.
[
    (
        rate: 70.0,
        max_particles: 40,
        lifetime: (0.18, 0.4),
        speed: (0.2, 0.9),
        spread: 180.0,
        drag: 3.5,
        acceleration: (0.0, -1.2, 0.0),
        sizes: [0.035, 0.012, 0.0],
        colors: [(1.0, 0.98, 0.92, 0.0), (0.85, 0.9, 1.0, 1.0), (0.5, 0.6, 1.0, 0.0)],
        emissive: 2.5,
        additive: 1.0,
        stretch: 0.03,
        shape: Soft,
    ),
]
