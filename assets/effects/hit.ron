// A blow landing: `rate: 0` with a `burst` plays once and ends, so `World::play_effect`
// removes it by itself. A glint and its light at the point of contact, then sparks that fall,
// bounce on the ground and die there.
[
    (
        rate: 0.0, burst: 1, lifetime: (0.09, 0.12), shape: Star,
        sizes: [0.25, 0.7, 0.0], colors: [(1.0, 0.9, 0.7, 1.0), (1.0, 0.5, 0.25, 0.0)],
        emissive: 12.0, additive: 1.0,
        light: (color: (1.0, 0.62, 0.38), intensity: 3.5, radius: 5.0, linger: 0.1),
    ),
    (
        rate: 0.0,
        burst: 26,
        lifetime: (0.25, 0.75),
        area: (0.08, 0.12, 0.08),
        speed: (1.6, 4.5),
        acceleration: (0.0, -9.0, 0.0),
        drag: 2.0,
        bounce: 0.35,
        sizes: [0.06, 0.045, 0.0],
        size_jitter: 0.4,
        colors: [(1.0, 0.72, 0.42, 1.0), (0.9, 0.3, 0.12, 1.0), (0.7, 0.08, 0.05, 0.0)],
        emissive: 7.0,
        additive: 1.0,
        stretch: 0.03,
        shape: Diamond,
    ),
]
