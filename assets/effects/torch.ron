// A burning torch, in layers: glow, tongues of flame, hot core, loose licks, embers, smoke
// and heat haze. Effect files are lists of emitters that play together; every field is
// optional (see ParticleDesc in crates/grimora_core/src/particles.rs). `sizes`, `colors`
// and `erode` are keys evenly spaced over each particle's life; colors are sRGB.
//
// What keeps it a torch and not a jet: the tongues barely rise, so its height comes from
// their shape and not their speed, they grow from the middle of the head, and they die small.
[
    // the air around it glows, and breathes
    (
        rate: 7.0,
        lifetime: (0.5, 0.9),
        position: (0.0, 0.16, 0.0),
        sizes: [0.7, 1.0, 0.8],
        size_jitter: 0.2,
        colors: [(1.0, 0.42, 0.14, 0.0), (1.0, 0.36, 0.1, 0.06), (0.9, 0.16, 0.05, 0.0)],
        emissive: 1.0,
        additive: 1.0,
        soft: 0.5,
    ),
    // tongues: the body of the fire, painted in hard bands from blood red to gold
    (
        rate: 24.0,
        lifetime: (0.3, 0.6),
        position: (0.0, -0.04, 0.0),
        area: (0.035, 0.0, 0.035),
        spread: 5.0,
        speed: (0.03, 0.12),
        acceleration: (0.0, 0.25, 0.0),
        drag: 1.5,
        curl: 0.45,
        curl_scale: 0.25,
        sizes: [0.1, 0.17, 0.13, 0.05],
        size_jitter: 0.35,
        upright: 0.95,
        shape: Flame,
        ramp: [(0.5, 0.0, 0.04, 1.3), (1.0, 0.26, 0.03, 3.2), (1.0, 0.82, 0.38, 8.0)],
        erode: [0.0, 0.04, 0.26, 0.8],
        noise: 1.3,
        flow: (0.06, -1.3),
        warp: 0.42,
        grain: 0.75,
        bands: 5.0,
        pixels: 120.0,
        soft: 0.08,
        emissive: 1.0,
        additive: 0.5,
    ),
    // the core: small and white hot, low in the fire
    (
        rate: 18.0,
        lifetime: (0.2, 0.36),
        position: (0.0, -0.03, 0.0),
        area: (0.02, 0.0, 0.02),
        spread: 4.0,
        speed: (0.02, 0.08),
        sizes: [0.07, 0.11, 0.05],
