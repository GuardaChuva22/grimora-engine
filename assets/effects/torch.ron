        warp: 0.25,
        grain: 0.55,
        bands: 4.0,
        pixels: 120.0,
        emissive: 1.0,
        additive: 0.8,
    ),
    // little licks at the tip, that burn out at once
    (
        rate: 7.0,
        lifetime: (0.1, 0.2),
        position: (0.0, 0.2, 0.0),
        area: (0.04, 0.05, 0.04),
        spread: 12.0,
        speed: (0.3, 0.6),
        drag: 2.0,
        curl: 0.8,
        curl_scale: 0.25,
