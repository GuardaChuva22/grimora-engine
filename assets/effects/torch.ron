// A burning torch: flame, smoke and sparks. Effect files are lists of emitters
// that play together; every field is optional (see ParticleDesc in
// crates/grimora_core/src/particles.rs). `sizes` and `colors` are keys evenly
// spaced over each particle's life; colors are sRGB with opacity.
[
    // flame: bright blobs that add light and feed the bloom
    (
        rate: 55.0,
        lifetime: (0.3, 0.65),
        area: (0.05, 0.02, 0.05),
        spread: 12.0,
        speed: (0.5, 1.0),
        acceleration: (0.0, 1.6, 0.0),
        drag: 1.0,
        turbulence: 1.4,
        sizes: [0.34, 0.24, 0.04],
        size_jitter: 0.3,
        colors: [(1.0, 0.72, 0.32, 1.0), (1.0, 0.4, 0.1, 0.9), (0.8, 0.12, 0.03, 0.0)],
        emissive: 5.0,
        additive: 1.0,
        spin: 60.0,
    ),
    // smoke: covers what is behind it and takes the scene's light
    (
        rate: 8.0,
        lifetime: (1.6, 2.8),
        position: (0.0, 0.55, 0.0),
        area: (0.05, 0.02, 0.05),
        spread: 14.0,
        speed: (0.4, 0.7),
        acceleration: (0.0, 0.25, 0.0),
        drag: 0.35,
        turbulence: 0.6,
        sizes: [0.2, 0.55, 0.95],
        size_jitter: 0.25,
        colors: [(0.1, 0.09, 0.1, 0.0), (0.13, 0.12, 0.13, 0.2), (0.18, 0.17, 0.19, 0.0)],
        lit: 1.0,
        spin: 25.0,
    ),
    // sparks: hard little shards stretched along their flight
    (
        rate: 5.0,
        lifetime: (0.5, 1.3),
        position: (0.0, 0.25, 0.0),
        area: (0.06, 0.04, 0.06),
        spread: 28.0,
        speed: (1.0, 2.4),
        acceleration: (0.0, -1.2, 0.0),
        drag: 0.6,
        turbulence: 5.0,
        sizes: [0.035, 0.015],
        colors: [(1.0, 0.75, 0.4, 1.0), (1.0, 0.32, 0.08, 1.0)],
        emissive: 10.0,
        additive: 1.0,
        stretch: 0.016,
        shape: Diamond,
    ),
]
